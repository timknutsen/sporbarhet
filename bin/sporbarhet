#!/usr/bin/env bash
# sporbarhet: hent foreldregenotyper til sporbarhetsleveranser (laks, redusert SNP-panel).
#
#   sporbarhet INFILE OUT_PREFIX [--force] [--keep-temp]
#
# Kjører pipeline_sporbarhet_v2.py (aqg_db2plink -> KING-duplikatsjekk -> PLINK-subset ->
# Affx->AX-IDer -> ped/map, kjønn=1) med et fast Python-miljø, slik at det virker
# uansett hvilke moduler eller conda-miljøer brukeren har lastet.
# Forfatter: Tim Knutsen, AquaGen.
set -euo pipefail

say() { printf 'sporbarhet: %s\n' "$*" >&2; }
die() { local code=$1; shift; say "FEIL: $*"; exit "$code"; }

usage() {
  cat <<'EOF'
Bruk:  sporbarhet INFILE OUT_PREFIX [--force] [--keep-temp]

  INFILE       fil med én PIT-tag per linje (f.eks. hann-foreldre)
  OUT_PREFIX   prefiks for resultatfilene; kan inneholde en mappe
               (f.eks. 2026_Cermaq-Q3-2025_to_Q3-2026 eller leveranse/2026_Cermaq)
  --force      overskriv eksisterende resultatfiler
  --keep-temp  behold mellomfiler for feilsøking

Lager OUT_PREFIX.ped/.map/.bed/.bim/.fam/.bim.backup_affx og OUT_PREFIX.<tidspunkt>.log,
i samme format som sporbarhetsleveransene fra 2025 og 2026:
tab-separert ped/map, FID/PAT/MAT=0, kjønn=1, fenotype=-9, SNP-IDer AX-*.

Avslutningskoder: 0 ok, 1 feil i input/miljø, 2 pipeline feilet, 3 formatsjekk feilet.
EOF
}

# ---------- argumenter ----------
force=0; keep=0; pos=()
for a in "$@"; do
  case "$a" in
    -h|--help) usage; exit 0 ;;
    --force) force=1 ;;
    --keep-temp) keep=1 ;;
    -*) usage >&2; die 1 "ukjent valg: $a" ;;
    *) pos+=("$a") ;;
  esac
done
(( ${#pos[@]} == 2 )) || { usage >&2; exit 1; }
infile=${pos[0]}; out=${pos[1]}

# ---------- fast miljø (uavhengig av brukerens moduler/conda) ----------
self=$(readlink -f "${BASH_SOURCE[0]}")
here=$(dirname "$self")
env_dir=${SPORBARHET_ENV:-/mnt/efshome/applications/miniconda3/envs/rust-185}
pipeline=${SPORBARHET_PIPELINE:-$here/../pipeline_sporbarhet_v2.py}
py=$env_dir/bin/python

unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE VIRTUAL_ENV \
      CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_SHLVL CONDA_PYTHON_EXE LD_PRELOAD
export PYTHONNOUSERSITE=1          # ~/.local-pakker skal ikke skygge for miljøets pandas
export PATH="$env_dir/bin:/usr/bin:/bin:$PATH"
export HOME=${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}

[[ -x $py ]] || die 1 "finner ikke Python i $env_dir (sett SPORBARHET_ENV til et miljø med Python >= 3.12, pandas og aqg_tools)"
[[ -r $pipeline ]] || die 1 "finner ikke pipeline: $pipeline"
[[ -r $HOME/.my.cnf ]] || die 1 "mangler $HOME/.my.cnf med tilgang til genotypedatabasen (genodb_v5); be om databasebruker"
check=$("$py" - <<'PY' 2>&1
import sys
if sys.version_info < (3, 12):
    sys.exit(f"Python {sys.version.split()[0]} er for gammel; pipelinen krever >= 3.12")
try:
    import pandas, aqg_tools  # noqa: F401
except Exception as e:
    sys.exit(f"mangler Python-pakke: {e}")
PY
) || die 1 "$check (miljø: $env_dir)"
command -v aqg_db2plink >/dev/null || die 1 "aqg_db2plink finnes ikke i $env_dir/bin"

# ---------- input ----------
[[ -f $infile ]] || die 1 "finner ikke INFILE: $infile"
outdir=$(dirname -- "$out"); base=$(basename -- "$out")
[[ $base =~ ^[A-Za-z0-9._+-]+$ ]] || die 1 "OUT_PREFIX kan bare inneholde A-Z, a-z, 0-9, . _ + - (fikk '$base')"
mkdir -p -- "$outdir" || die 1 "kan ikke lage mappe $outdir"
outdir=$(cd -- "$outdir" && pwd)
[[ -w $outdir ]] || die 1 "har ikke skrivetilgang til $outdir"

finals=(ped map bed bim fam bim.backup_affx)
if (( ! force )); then
  for ext in "${finals[@]}"; do
    [[ -e $outdir/$base.$ext ]] && die 1 "$outdir/$base.$ext finnes allerede; velg nytt OUT_PREFIX eller bruk --force"
  done
fi

work=$(mktemp -d "$outdir/.sporbarhet_${base}.XXXXXX")
cleanup_work() { (( keep )) || rm -rf -- "$work"; }

# rens ID-lista: BOM, CR (Excel/Windows), mellomrom, tomme linjer, dubletter
ids=$work/$(basename -- "$infile" | tr -c 'A-Za-z0-9._+\n-' '_')
LC_ALL=C sed '1s/^\xEF\xBB\xBF//' -- "$infile" | tr -d '\r' | awk 'NF { $1 = $1; print }' > "$work/ids.raw"
multi=$(awk 'NF > 1' "$work/ids.raw" | wc -l)
(( multi == 0 )) || { cleanup_work; die 1 "$multi linje(r) i $infile har mer enn én kolonne; forventet én PIT-tag per linje"; }
awk '!seen[$1]++' "$work/ids.raw" > "$ids"
n_raw=$(wc -l < "$work/ids.raw"); n_ids=$(wc -l < "$ids"); rm -f -- "$work/ids.raw"
(( n_ids > 0 )) || { cleanup_work; die 1 "$infile inneholder ingen IDer"; }
(( n_raw == n_ids )) || say "advarsel: fjernet $((n_raw - n_ids)) dublett-linje(r) fra ID-lista"
say "$n_ids IDer fra $infile -> $outdir/$base.*"

# ---------- kjør pipelinen i egen arbeidsmappe ----------
flags=(); (( keep )) && flags=(--no-cleanup)
set +e
( cd -- "$work" && "$py" "$pipeline" -o "$base" -p "$(basename -- "$ids")" "${flags[@]}" )
rc=$?
set -e
for log in "$work/$base".*.log; do [[ -e $log ]] && cp -p -- "$log" "$outdir/"; done
if (( rc != 0 )); then
  keep=1
  die 2 "pipelinen feilet (kode $rc). Logg: $outdir/$(basename -- "$(ls -t "$work/$base".*.log 2>/dev/null | head -1)") ; mellomfiler beholdt i $work"
fi
for ext in "${finals[@]}"; do
  [[ -e $work/$base.$ext ]] || { keep=1; die 2 "pipelinen laget ikke $base.$ext; se $work"; }
  mv -f -- "$work/$base.$ext" "$outdir/"
done

# ---------- formatsjekk mot leveranseformatet ----------
ped=$outdir/$base.ped; map=$outdir/$base.map
summary=$(awk -F'\t' -v ids="$ids" '
  FNR == 1 { file++ }
  file == 1 { want[$1] = 1; nwant++; next }
  file == 2 {                                   # map
    nsnp++
    if (NF != 4 || $2 !~ /^AX-/ || $3 != "0" || $1 !~ /^([1-9]|1[0-9]|2[0-9])$/) badmap++
    next
  }
  {                                             # ped
    nind++
    if (NF != 6 + 2 * nsnp) badwidth++
    if ($1 != "0" || $3 != "0" || $4 != "0" || $5 != "1" || $6 != "-9") badfix++
    if (!($2 in want)) unknown++; else if (!seen[$2]++) found++
    for (i = 7; i <= NF; i++) { calls++; if ($i == "0") miss++; else if ($i !~ /^[ACGT]$/) badallele++ }
  }
  END {
    err = badmap + badwidth + badfix + badallele + unknown + (nwant - found) + (nind != nwant)
    printf "%d %d %d %d %d %d %d %d %.4f %d\n", err, nind, nsnp, badmap, badwidth, badfix, badallele, nwant - found, (calls ? 1 - miss / calls : 0), unknown
  }' "$ids" "$map" "$ped")
read -r err nind nsnp badmap badwidth badfix badallele missing_ids callrate unknown <<< "$summary"
[[ $(head -c 100000 "$ped" | tr -cd '\r' | wc -c) -eq 0 ]] || err=$((err + 1))
if (( err > 0 )); then
  keep=1
  die 3 "formatsjekk feilet: map-linjer=$badmap, ped-bredde=$badwidth, faste kolonner=$badfix, alleler=$badallele, manglende IDer=$missing_ids, ukjente IDer=$unknown, ped-rader=$nind (forventet $n_ids)"
fi
cleanup_work
say "OK: $nind individer x $nsnp SNP-er, genotyperingsgrad $callrate; format som leveransene 2025-2026"
